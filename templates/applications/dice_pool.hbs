<form class="wildsteppe flexcol spaced">

  <div class="form-group">
    <label>{{localize "wildsteppe.skill"}}</label>
    <div class="form-fields">
      <select id="skill" name="skill" class="corners">
        <option value="">{{localize "wildsteppe.none"}}</option>
        {{{selectOptGroup skillOptions selected=skill label=(localize "wildsteppe.skill")}}}
      </select>
    </div>
  </div>
  
  <div class="form-group">
    <label>{{localize "wildsteppe.advantage"}}</label>
    <div class="form-fields">
      <select id="advantage" name="advantage" class="corners">
      {{selectOptions advantageOptions selected=advantage}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "wildsteppe.cut"}}</label>
    <div class="form-fields">
      <select id="cut" name="cut" class="corners">
      {{selectOptions cutOptions selected=cut}}
      </select>
    </div>
  </div>

  <div class="flexrow spaced">
    <div class="center">
      <a class="block corners mid padded submit">Submit</a>
    </div>
    
    <div class="center">
      <a class="block cancel corners light padded">Cancel</a>
    </div>
  </div>
</form>
