<div class="track {{track.displayVisibility}}" data-track-id="{{track.id}}">
  <a class="label" {{#if (ne track.displayVisibility 'open')}}data-tooltip="{{localize (concat "wildsteppe.TRACKS." track.displayVisibility)}}"{{/if}}>{{label}}</a>
  <div class="slots">
    {{#if (or @root.options.editable (eq track.displayVisibility 'open'))}}
    {{{renderTrack track}}}
    {{/if}}
  </div>
  {{#if @root.options.editable}}
  <a class="delete">
    <i class="fas fa-trash"></i>
  </a>
  {{/if}}
</div>
