<form class="wildsteppe">
  <div class="flexrow spaced ship-container">
    <div class="flexcol spaced">
      <div class="flex flex0 flexrow spaced">
        <div class="flex0 img"><img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" /></div>
        <div>
          <input id="name" class="corners" type="text" name="name" value="{{actor.name}}" placeholder="{{localize "wildsteppe.name"}}" />
        </div>
      </div>
      {{> "systems/wild-steppe/templates/shared/text_field.hbs" field="system.type" value=system.type label="wildsteppe.shipType"}}
      {{> "systems/wild-steppe/templates/shared/text_field.hbs" field="system.drive" value=system.drive label="wildsteppe.drive"}}
      
      {{> "systems/wild-steppe/templates/sheets/ship/ratings.hbs"}}
      {{> "systems/wild-steppe/templates/shared/aspects.hbs"
        aspects=factions
        title=(localize "wildsteppe.factions")
        type="faction"}}
      {{> "systems/wild-steppe/templates/sheets/ship/cargo.hbs"}}

    </div>
    <div class="flexcol spaced">
      {{> "systems/wild-steppe/templates/shared/aspects.hbs"
        aspects=aspects
        title=(localize "wildsteppe.aspects")
        type="aspect"}}
      {{> "systems/wild-steppe/templates/shared/aspects.hbs"
        aspects=temporaryAspects
        title=(localize "wildsteppe.temporaryAspects")
        type="temporaryAspect"}}
      {{> "systems/wild-steppe/templates/shared/aspects.hbs"
        aspects=projects
        title=(localize "wildsteppe.projects")
        type="project"}}
    </div>

  </div>
</form>
