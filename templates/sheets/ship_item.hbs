<form class="wildsteppe">
  <div class="flexcol spaced">
    <div id="header" class="flexrow spaced">
      <div class="flexrow spaced">
        <div class="flex0 img"><img src="{{item.img}}" data-edit="img" title="{{item.name}}" /></div>
        <div class="flexcol spaced">
          <input id="name" class="corners" type="text" name="name" value="{{item.name}}" placeholder="{{localize "wildsteppe.name"}}" />
          <div class="flexrow spaced">
            {{> "systems/wild-steppe/templates/shared/text_field.hbs" field="system.type" value=system.type label="wildsteppe.type"}}
            {{#if hasTrack}}
              {{> "systems/wild-steppe/templates/shared/number_field.hbs" field="system.track.max" value=system.track.max label="wildsteppe.track" min=0 max=8}}
            {{/if}}
          </div>
        </div>
      </div>
    </div>

    <div id="body" class="flexcol spaced">
      <section class="navigation">
        <nav class="sheet-tabs tabs flexrow spaced" data-group="primary">
          <a data-tab="main">{{localize "wildsteppe.description"}}</a>
          <a data-tab="ratingMods">{{localize "wildsteppe.ratingMods"}}</a>
        </nav>
      </section>

      <section class="sheet-body">
        <div class="tab-main tab" data-group="primary" data-tab="main">
          {{> "systems/wild-steppe/templates/shared/description.hbs" content=system.enrichedDetails target="system.details"}}
        </div>
        <div class="tab-rating-mods tab" data-group="primary" data-tab="ratingMods">
          {{> "systems/wild-steppe/templates/shared/rating_mods.hbs"}}
        </div>
      </section>
    </div>
  </div>
</form>
