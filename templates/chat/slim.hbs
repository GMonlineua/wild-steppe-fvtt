<div class="wildsteppe">
  <h3>{{title}}</h3>
  {{#if track}}
    <ul class="track">
    {{#times track.max}}
      {{{trackCell @index ../track.value ../track.burn}}}
    {{/times}}
    </ul>
  {{/if}}
  <p>{{text}}</p>
  {{#if description}}
    <p class="slim-description">{{description}}</p>
  {{/if}}
</div>
